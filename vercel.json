{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": [
    "cle1"
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?__path=:path*"
    },
    {
      "source": "/mom-mode",
      "destination": "/mom-mode/index.html"
    },
    {
      "source": "/mom-mode/",
      "destination": "/mom-mode/index.html"
    },
    {
      "source": "/games/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/join/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/solo/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/review",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!api/|assets/|sw\\.js$).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
