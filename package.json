{
  "name": "same-same-but-different",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/dev-server.mjs",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node scripts/build.mjs && node --test --test-concurrency=1 test/e2e/*.test.mjs",
    "check": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright": "^1.56.1"
  },
  "engines": {
    "node": ">=22.5"
  }
}
