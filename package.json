{
  "name": "same-same-but-different",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/dev-server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node scripts/build.mjs && node --test --test-concurrency=1 test/e2e/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.25.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright": "^1.56.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.5"
  }
}
