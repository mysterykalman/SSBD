{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ],
    "types": [],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "include": [
    "src/shared/**/*.js",
    "src/server/**/*.js",
    "src/client/store.js",
    "src/server/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "reference"
  ]
}
